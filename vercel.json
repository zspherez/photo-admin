{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    { "path": "/api/cron/sync-shows", "schedule": "0 9 * * *" },
    { "path": "/api/cron/sync-listens", "schedule": "0 11 * * *" },
    { "path": "/api/cron/contact-research", "schedule": "0 13 * * *" }
  ],
  "functions": {
    "app/api/queues/custom-emails/route.ts": {
      "experimentalTriggers": [
        { "type": "queue/v2beta", "topic": "custom-email-dispatch" }
      ]
    }
  },
  "schedules": {
    "custom-email-recovery": {
      "schedule": "*/15 9-13 * * 1-5",
      "timezone": "America/New_York",
      "topic": "custom-email-dispatch"
    }
  }
}
